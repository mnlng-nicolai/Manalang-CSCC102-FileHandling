        "        printable_content = f\"\"\"\n",
        "        <div id=\"print-area\" style=\"padding:6px;\">\n",
        "            <div style=\"padding:18px; background:#fff0f3; border:4px solid #f0b6c6; margin-bottom:16px;\">\n",
