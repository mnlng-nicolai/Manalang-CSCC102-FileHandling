        "</style>\n",
        "\"\"\"\n",
        "\n",
        "# ---------- Widgets ----------\n",
        "file_uploader = widgets.FileUpload(accept='.csv', multiple=False, description='Upload CSV',\n",
        "                                   layout=widgets.Layout(width='190px', height='42px'))\n",
        "file_uploader.add_class('px-btn'); file_uploader.add_class('px-blue')\n",
